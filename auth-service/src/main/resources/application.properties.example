spring.application.name=urlshortener-auth-service
server.port=8080

spring.datasource.url=${DB_URL:jdbc:postgresql://localhost:5432/authdb}
spring.datasource.username=${DB_USER:authuser}
spring.datasource.password=${DB_PASSWORD:authpass}

# Flyway owns the schema; Hibernate only checks that it matches the entities
spring.jpa.hibernate.ddl-auto=validate
spring.jpa.open-in-view=false
spring.flyway.enabled=true

app.jwt.secret=${JWT_SECRET}
app.jwt.expiry-seconds=${JWT_EXPIRY_SECONDS:900}
app.session.refresh-expiry-days=${REFRESH_EXPIRY_DAYS:30}
